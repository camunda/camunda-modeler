[
  {
    "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
    "name": "Credentials E2E",
    "id": "io.camunda.examples.CredentialsE2E",
    "description": "Element template with a credential chooser, used by the e2e suite.",
    "version": 1,
    "appliesTo": [
      "bpmn:Task"
    ],
    "elementType": {
      "value": "bpmn:ServiceTask"
    },
    "engines": {
      "camunda": "^8.10"
    },
    "configurationTemplates": [
      {
        "id": "io.camunda:e2e-credential:1",
        "kind": "CREDENTIAL",
        "version": 1,
        "name": "E2E Credential",
        "properties": [
          {
            "id": "token",
            "label": "API token",
            "type": "String",
            "constraints": {
              "notEmpty": true
            },
            "binding": {
              "name": "token",
              "type": "property"
            }
          }
        ]
      }
    ],
    "groups": [
      {
        "id": "authentication",
        "label": "Authentication"
      }
    ],
    "properties": [
      {
        "value": "io.camunda:e2e:1",
        "binding": {
          "property": "type",
          "type": "zeebe:taskDefinition"
        },
        "type": "Hidden"
      },
      {
        "id": "credential",
        "label": "E2E credential",
        "type": "Configuration",
        "configurationTemplate": "io.camunda:e2e-credential:1",
        "configurationTemplateVersion": 1,
        "group": "authentication",
        "optional": true,
        "binding": {
          "name": "credential",
          "type": "zeebe:input"
        }
      }
    ]
  }
]
