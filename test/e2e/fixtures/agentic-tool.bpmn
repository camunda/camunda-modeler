<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_agentic_tool" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0-rc.0-dev" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_to_agent</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:adHocSubProcess id="AgentSubProcess_1" name="Agent">
      <bpmn:extensionElements>
        <zeebe:adHoc />
        <zeebe:taskDefinition type="io.camunda:agent:1" />
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_agent</bpmn:incoming>
      <bpmn:serviceTask id="Activity_1dlpph5" name="Send Message" zeebe:modelerTemplate="io.camunda.connectors.Slack.v1" zeebe:modelerTemplateVersion="9" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:slack:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=abc" target="token" />
            <zeebe:input source="chat.postMessage" target="method" />
            <zeebe:input source="plainText" target="data.messageType" />
            <zeebe:input source="=fromAi(toolCall.message)" target="data.text" />
            <zeebe:input target="data.channel" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="9" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.Slack.v1" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ToolTask_FromAiContract" name="Fetch URL" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="17" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Fetches the contents of a URL supplied by the agent.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="=fromAi(toolCall.url)" target="url" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="JSON" target="documentReturnFormat.choice" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="17" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultVariable" value="everything" />
            <zeebe:header key="resultExpression" value="={&#10;  something: response.body&#10;  // Use FEEL to extract values, e.g.,:&#10;  // myUserId: response.body.post.userId&#10;}" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ToolTask_1" name="Fetch URL">
        <bpmn:documentation>ABC</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="tool" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.url, &#34;TODO: describe this value for the agent&#34;, &#34;string&#34;)" target="url" />
            <zeebe:input source="=fromAi(toolCall.this, &#34;TODO: describe this value for the agent&#34;, &#34;string&#34;)" target="this" />
            <zeebe:output source="=result" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:endEvent id="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_to_agent" sourceRef="StartEvent_1" targetRef="AgentSubProcess_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="212" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AgentSubProcess_1_di" bpmnElement="AgentSubProcess_1" isExpanded="true">
        <dc:Bounds x="240" y="100" width="550" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1fvdoi3_di" bpmnElement="Activity_1dlpph5">
        <dc:Bounds x="430" y="190" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToolTask_FromAiContract_di" bpmnElement="ToolTask_FromAiContract">
        <dc:Bounds x="590" y="190" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToolTask_1_di" bpmnElement="ToolTask_1">
        <dc:Bounds x="290" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="720" y="212" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_to_agent_di" bpmnElement="Flow_to_agent">
        <di:waypoint x="188" y="230" />
        <di:waypoint x="240" y="230" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
