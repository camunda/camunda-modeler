{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Approve invoice",
  "id": "io.camunda.examples.registry.ApproveInvoice",
  "description": "Routes an invoice for approval.",
  "appliesTo": [
    "bpmn:ServiceTask"
  ],
  "version": 1,
  "engines": {
    "camunda": "^8.6"
  },
  "properties": [
    {
      "type": "Hidden",
      "value": "approve-invoice",
      "binding": {
        "type": "zeebe:taskDefinition:type"
      }
    },
    {
      "label": "Invoice number",
      "description": "The invoice to approve.",
      "type": "String",
      "binding": {
        "type": "zeebe:input",
        "name": "invoiceNumber"
      },
      "constraints": {
        "notEmpty": true
      }
    }
  ]
}
